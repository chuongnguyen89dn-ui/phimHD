FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends chromium ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt yt-dlp-getpot-wpc
COPY . .
ENV YTDLP_WPC_BROWSER=/usr/bin/chromium
CMD ["gunicorn","app:app","--bind","0.0.0.0:10000","--timeout","180"]